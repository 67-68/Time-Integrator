QWidget, QMainWindow {
    background-color:rgb(243,237,232); 
    color:rgb(165, 126, 126);           
    font-family: "Segoe UI";
}

QFrame { 
    border: 1px solid
    border-radius: 8px;
}

QScrollArea {
    border: none; /* 移除滚动区域自带的丑陋边框 */
}

QScrollBar:vertical {
    background: #1E1E1E; /* 滚动条背景与窗口背景一致 */
    width: 10px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #4A4A4A; /* 滚动条滑块的颜色 */
    min-height: 20px;
    border-radius: 5px; /* 圆角滑块是现代感的关键 */
}
QScrollBar::handle:vertical:hover {
    background: #5A5A5A;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}


/* ----------------------- 3. 核心UI元素：洞察卡片 ----------------- */
/* 使用 objectName 来精确指定我们的自定义卡片 */
TrendCard { 
    background-color: #2D2D2D; /* 卡片背景比窗口背景稍亮，制造层次感 */
    border: 1px solid #3A3A3A;   /* 一个非常柔和的、几乎看不见的边框 */
    border-radius: 10px;         /* 关键！柔和的圆角 */
    padding: 20px;               /* 关键！充足的内边距让内容呼吸 */
}

/* 卡片内的不同文本标签 */
#titleLabel {
    font-size: 16px;
    font-weight: bold;
    color:rgb(213,57,132);
}

#semanticLabel {
    font-size: 14px;
    color: #D4D4D4;
    padding-top: 10px; /* 让消息与标题之间有空间 */
}

#accentBar { /* 卡片左侧那条彩色的竖线 */
    background-color: #3498DB; /* 默认颜色，可以在代码中覆盖 */
    border-radius: 2px;
}

/* ----------------------- 4. 可交互控件 -------------------------- */
QToolButton {
    background-color:rgb(218,223,226); 
    color:rgb(96, 121, 147); /* 修改字体颜色 */
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    box-shadow: 2px 2px 5px rgb(0, 0, 0); /* 添加阴影 */
}
QToolButton:hover {
    background-color:rgb(202, 218, 230); /* 悬停时变亮 */
}
QToolButton:pressed {
    background-color:rgb(184, 187, 189); /* 按下时变暗 */
}

QLineEdit, QTextEdit {
    background-color:rgb(229, 229, 229);
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 8px;
    color: #D4D4D4;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #3498DB; /* 聚焦时用主题色高亮边框 */
}



