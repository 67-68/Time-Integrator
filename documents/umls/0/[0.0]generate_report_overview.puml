这个文件用来表示最上层的report_generation功能,即卡片生成
但目前只有conditional_Card

@startuml
participant "Time_Integrator: app" as app
participant "MainCoodinator: coodinator" as coodinator
participant "CardController: controller" as controller

group Initialization
    activate app

    ' 创建Coodinator, 注入依赖
    app -> coodinator: __init__(data,service)
    activate coodinator

    ' 创建controller
    coodinator -> controller: __init__(data,service)
    activate controller

    ref over controller
        此处的图纸在Documents/umls/[1.5]cardController_init
    end ref

    controller --> coodinator: return cardCtrl: CardController
    deactivate controller

end group

' 自动生成卡片
group Generation
    coodinator -> controller: create_ytd_card()
    activate controller

    ref over controller
        生成卡片
        这里的图纸参考Documents/umls/[1.5]cardController_generation
    end ref

    controller --> coodinator: return None
    deactivate controller
end group
@enduml